# Copy this file to .env and fill in real values.
# Do not commit .env to Git.

# OpenAI-compatible LLM.
# Default is Gemini API free tier. Paste your Gemini API key into LLM_API_KEY.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash-lite

# Other free/testing OpenAI-compatible options:
# SiliconFlow:
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# Groq:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
#
# Zhipu:
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash

# DeepSeek (OpenAI-compatible).
# Docs: https://api-docs.deepseek.com/
# If LLM_PROVIDER=openai-compatible and using DeepSeek, fill these instead.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Keep LlamaIndex cache inside the project to make behavior easier to inspect.
LLAMA_INDEX_CACHE_DIR=.cache/llamaindex

# Local embedding model for Stage 1.
# The model has been downloaded to this project cache.
BGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BGE_CACHE_DIR=.cache/llamaindex
BGE_LOCAL_FILES_ONLY=true
